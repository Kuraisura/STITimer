<Window x:Class="STITimer.ThinkQuestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Think Quest"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        Opacity="0"
        KeyDown="Window_KeyDown">
    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.5">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
    <Window.Resources>
        <Style x:Key="PresetCardStyle" TargetType="Border">
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="180"/>
        </Style>
        <Style x:Key="PresetNameStyle" TargetType="TextBox">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="Transparent" BorderThickness="0,0,0,1" BorderBrush="#44FFFFFF" Padding="4,2">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ConfigInputStyle" TargetType="TextBox">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="#33FFFFFF"
                                BorderThickness="0,0,0,2"
                                BorderBrush="#88FFFFFF"
                                CornerRadius="4"
                                Padding="8,4">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TimerButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#66FFFFFF"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="30,12"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <Border.Background>
                                <SolidColorBrush x:Name="BdBg" Color="#44FFFFFF"/>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="BdBg"
                                                            Storyboard.TargetProperty="Color"
                                                            To="#66FFFFFF" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="BdBg"
                                                            Storyboard.TargetProperty="Color"
                                                            To="#44FFFFFF" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="BdBg"
                                                            Storyboard.TargetProperty="Color"
                                                            To="#88FFFFFF" Duration="0:0:0.05"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="BdBg"
                                                            Storyboard.TargetProperty="Color"
                                                            To="#66FFFFFF" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="Images/STI_Tagisan_Ng_Talino_Complete_Transparent.png" Stretch="UniformToFill"/>
        </Grid.Background>

        <!-- Event Branding (behind overlay) -->
        <Image Source="Images/tagisan_ng_talino_font.png"
               Height="80" Stretch="Uniform"
               HorizontalAlignment="Right" VerticalAlignment="Top"
               Margin="0,15,20,0" Opacity="0.4"
               IsHitTestVisible="False"/>

        <Grid x:Name="Overlay" Background="#AA000000">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Event Logo -->
            <Image x:Name="EventImage" Grid.Row="0"
                   Height="120" Stretch="Uniform"
                   VerticalAlignment="Center"
                   Margin="0,20,0,0"/>

            <!-- Difficulty Presets -->
            <StackPanel x:Name="PresetsPanel" Grid.Row="1" Orientation="Horizontal"
                        HorizontalAlignment="Center" Margin="0,10">
                <Border x:Name="EasyCard" Style="{StaticResource PresetCardStyle}"
                        Background="#442E7D32" BorderBrush="#994CAF50"
                        MouseLeftButtonDown="EasyCard_Click">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBox x:Name="EasyNameBox" Text="Easy"
                                 Style="{StaticResource PresetNameStyle}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                            <TextBox x:Name="EasyTimeBox" Text="15" Width="45"
                                     Style="{StaticResource ConfigInputStyle}"/>
                            <TextBlock Text="s" Foreground="White" FontSize="20"
                                       VerticalAlignment="Center" Margin="4,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border x:Name="MediumCard" Style="{StaticResource PresetCardStyle}"
                        Background="#44FF8F00" BorderBrush="#99FFB300"
                        MouseLeftButtonDown="MediumCard_Click">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBox x:Name="MediumNameBox" Text="Medium"
                                 Style="{StaticResource PresetNameStyle}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                            <TextBox x:Name="MediumTimeBox" Text="30" Width="45"
                                     Style="{StaticResource ConfigInputStyle}"/>
                            <TextBlock Text="s" Foreground="White" FontSize="20"
                                       VerticalAlignment="Center" Margin="4,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border x:Name="HardCard" Style="{StaticResource PresetCardStyle}"
                        Background="#44C62828" BorderBrush="#99EF5350"
                        MouseLeftButtonDown="HardCard_Click">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBox x:Name="HardNameBox" Text="Hard"
                                 Style="{StaticResource PresetNameStyle}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                            <TextBox x:Name="HardTimeBox" Text="45" Width="45"
                                     Style="{StaticResource ConfigInputStyle}"/>
                            <TextBlock Text="s" Foreground="White" FontSize="20"
                                       VerticalAlignment="Center" Margin="4,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Timer Display -->
            <Viewbox Grid.Row="2" Stretch="Uniform"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Margin="40,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="MinutesDisplay" Text="00"
                               FontSize="280" FontWeight="Bold" FontFamily="Consolas"
                               Foreground="White"/>
                    <TextBlock x:Name="SeparatorDisplay" Text=":"
                               FontSize="280" FontWeight="Bold" FontFamily="Consolas"
                               Foreground="White" Margin="5,0"/>
                    <TextBlock x:Name="SecondsDisplay" Text="15"
                               FontSize="280" FontWeight="Bold" FontFamily="Consolas"
                               Foreground="White"/>
                </StackPanel>
            </Viewbox>

            <!-- Status Label -->
            <TextBlock x:Name="StatusLabel" Grid.Row="3"
                       Text="TIME'S UP" FontSize="80" FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       Visibility="Collapsed"
                       Margin="0,0,0,10"/>

            <!-- Controls -->
            <StackPanel Grid.Row="4" Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,5">
                <Button x:Name="StartPauseButton" Content="▶  Start"
                        Style="{StaticResource TimerButtonStyle}"
                        Click="StartPause_Click"/>
                <Button x:Name="ResetButton" Content="⏹  Reset"
                        Style="{StaticResource TimerButtonStyle}"
                        Click="Reset_Click"/>
            </StackPanel>

            <!-- Keybind Hint -->
            <TextBlock x:Name="HintText" Grid.Row="5"
                       Text="SPACE = Start / Pause    •    R = Retry    •    T = Toggle Categories    •    ESC = Exit"
                       Foreground="#88FFFFFF" FontSize="18"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>
        </Grid>

            </Grid>
        </Window>
