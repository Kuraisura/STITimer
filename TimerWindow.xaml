<Window x:Class="STITimer.TimerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Event Timer"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        Opacity="0"
        KeyDown="Window_KeyDown">
    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.5">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
    <Window.Resources>
        <Style x:Key="TimerDigitStyle" TargetType="TextBox">
            <Setter Property="FontSize" Value="220"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="MaxLength" Value="2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="Transparent"
                                BorderThickness="0,0,0,3"
                                BorderBrush="#55FFFFFF"
                                Padding="8,0">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TimerSeparatorStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="220"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8,0"/>
        </Style>
        <Style x:Key="TimerButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#66FFFFFF"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="30,12"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <Border.Background>
                                <SolidColorBrush x:Name="BdBg" Color="#44FFFFFF"/>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="BdBg"
                                                            Storyboard.TargetProperty="Color"
                                                            To="#66FFFFFF" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="BdBg"
                                                            Storyboard.TargetProperty="Color"
                                                            To="#44FFFFFF" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="BdBg"
                                                            Storyboard.TargetProperty="Color"
                                                            To="#88FFFFFF" Duration="0:0:0.05"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="BdBg"
                                                            Storyboard.TargetProperty="Color"
                                                            To="#66FFFFFF" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="Images/STI_Tagisan_Ng_Talino_Complete_Transparent.png" Stretch="UniformToFill"/>
        </Grid.Background>

        <!-- Event Branding (behind overlay) -->
        <Image Source="Images/tagisan_ng_talino_font.png"
               Height="80" Stretch="Uniform"
               HorizontalAlignment="Right" VerticalAlignment="Top"
               Margin="0,15,20,0" Opacity="0.4"
               IsHitTestVisible="False"/>

        <!-- Dark overlay for readability -->
        <Grid x:Name="Overlay" Background="#AA000000">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Event Logo -->
            <Image x:Name="EventImage" Grid.Row="0"
                   Height="200"
                   Stretch="Uniform"
                   Margin="0,20,0,10"/>

            <!-- Timer Display -->
            <Viewbox Grid.Row="1" Stretch="Uniform"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Margin="40,10">
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="HoursBox" Style="{StaticResource TimerDigitStyle}"
                             Width="300"/>
                    <TextBlock x:Name="Separator1" Text=":" Style="{StaticResource TimerSeparatorStyle}"/>
                    <TextBox x:Name="MinutesBox" Style="{StaticResource TimerDigitStyle}"
                             Width="300"/>
                    <TextBlock x:Name="Separator2" Text=":" Style="{StaticResource TimerSeparatorStyle}"/>
                    <TextBox x:Name="SecondsBox" Style="{StaticResource TimerDigitStyle}"
                             Width="300"/>
                </StackPanel>
            </Viewbox>

            <!-- Controls -->
            <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,20">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,5">
                    <Button x:Name="StartPauseButton" Content="▶  Start"
                            Style="{StaticResource TimerButtonStyle}"
                            Click="StartPause_Click"/>
                    <Button x:Name="ResetButton" Content="⏹  Reset"
                            Style="{StaticResource TimerButtonStyle}"
                            Click="Reset_Click"/>
                </StackPanel>
                <TextBlock x:Name="HintText" Text="SPACE = Start / Pause    •    R = Reset    •    ESC = Exit"
                           Foreground="#88FFFFFF" FontSize="18"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Status Label -->
            <TextBlock x:Name="StatusLabel" Grid.Row="3"
                       Text="TIME'S UP" FontSize="80" FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       Visibility="Collapsed"
                       Margin="0,0,0,10"/>
        </Grid>

            </Grid>
        </Window>
