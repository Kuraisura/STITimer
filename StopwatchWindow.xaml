<Window x:Class="STITimer.StopwatchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stopwatch"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        Opacity="0"
        KeyDown="Window_KeyDown">
    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.5">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
    <Window.Resources>
        <Style x:Key="TimerSeparatorStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="220"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8,0"/>
        </Style>
        <Style x:Key="TimerButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#66FFFFFF"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="30,12"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <Border.Background>
                                <SolidColorBrush x:Name="BdBg" Color="#44FFFFFF"/>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="BdBg"
                                                            Storyboard.TargetProperty="Color"
                                                            To="#66FFFFFF" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="BdBg"
                                                            Storyboard.TargetProperty="Color"
                                                            To="#44FFFFFF" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="BdBg"
                                                            Storyboard.TargetProperty="Color"
                                                            To="#88FFFFFF" Duration="0:0:0.05"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="BdBg"
                                                            Storyboard.TargetProperty="Color"
                                                            To="#66FFFFFF" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="Images/STI_Tagisan_Ng_Talino_Complete_Transparent.png" Stretch="UniformToFill"/>
        </Grid.Background>

        <!-- Event Branding (behind overlay) -->
        <Image Source="Images/tagisan_ng_talino_font.png"
               Height="80" Stretch="Uniform"
               HorizontalAlignment="Right" VerticalAlignment="Top"
               Margin="0,15,20,0" Opacity="0.4"
               IsHitTestVisible="False"/>

        <Grid Background="#AA000000">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
            </Grid.RowDefinitions>

            <!-- Event Logo -->
            <Image x:Name="EventImage" Grid.Row="0"
                   Height="200"
                   Stretch="Uniform"
                   Margin="0,20,0,10"/>

            <!-- Elapsed Label -->
            <TextBlock Grid.Row="1" Text="⏱  ELAPSED TIME"
                       FontSize="32" FontWeight="SemiBold"
                       Foreground="#BBFFFFFF"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,0"/>

            <!-- Stopwatch Display -->
            <Viewbox Grid.Row="2" Stretch="Uniform"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Margin="40,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="HoursDisplay" Text="00"
                               FontSize="220" FontWeight="Bold" FontFamily="Consolas"
                               Foreground="White"/>
                    <TextBlock Text=":" Style="{StaticResource TimerSeparatorStyle}"/>
                    <TextBlock x:Name="MinutesDisplay" Text="00"
                               FontSize="220" FontWeight="Bold" FontFamily="Consolas"
                               Foreground="White"/>
                    <TextBlock Text=":" Style="{StaticResource TimerSeparatorStyle}"/>
                    <TextBlock x:Name="SecondsDisplay" Text="00"
                               FontSize="220" FontWeight="Bold" FontFamily="Consolas"
                               Foreground="White"/>
                </StackPanel>
            </Viewbox>

            <!-- Controls + Hint -->
            <StackPanel Grid.Row="3" HorizontalAlignment="Center" Margin="0,10,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,5">
                    <Button x:Name="StartPauseButton" Content="▶  Start"
                            Style="{StaticResource TimerButtonStyle}"
                            Click="StartPause_Click"/>
                    <Button Content="⏹  Reset"
                            Style="{StaticResource TimerButtonStyle}"
                            Click="Reset_Click"/>
                </StackPanel>
                <TextBlock Text="SPACE = Start / Pause    •    R = Reset    •    ESC = Exit"
                           Foreground="#88FFFFFF" FontSize="18"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
