<Window x:Class="STITimer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="STI Tagisan Ng Talino" Height="768" Width="1366"
        WindowState="Maximized"
        KeyDown="Window_KeyDown">
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="Images/STI_Tagisan_Ng_Talino_Complete_Transparent.png" Stretch="UniformToFill" />
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="20"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="1.6*"/>
            <RowDefinition Height="1.6*"/>
            <RowDefinition Height="20"/>
        </Grid.RowDefinitions>

        <!-- Banner -->
        <Button Grid.Row="1" Style="{StaticResource ImageButtonStyle}"
                Tag="Images/STI_Tagisan_Ng_Talino_Banner.png"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="40,10"
                Click="Banner_Click"/>

        <!-- Row 2: First 5 buttons -->
        <UniformGrid Grid.Row="2" Rows="1" Columns="5"
                     HorizontalAlignment="Stretch"
                     Margin="40,0">
            <Button Style="{StaticResource ImageButtonStyle}"
                    Tag="Images/All_In_Place.png"
                    Click="AllInPlace_Click"/>
            <Button Style="{StaticResource ImageButtonStyle}"
                    Tag="Images/Chef_Xpress.png"
                    Click="ChefXpress_Click"/>
            <Button Style="{StaticResource ImageButtonStyle}"
                    Tag="Images/Codefest.png"
                    Click="Codefest_Click"/>
            <Button Style="{StaticResource ImageButtonStyle}"
                    Tag="Images/Essay_Does_It.png"
                    Click="EssayDoesIt_Click"/>
            <Button Style="{StaticResource ImageButtonStyle}"
                    Tag="Images/Mix_&amp;_Flair.png"
                    Click="MixAndFlair_Click"/>
        </UniformGrid>

        <!-- Row 3: Last 4 buttons -->
        <UniformGrid Grid.Row="3" Rows="1" Columns="4"
                     HorizontalAlignment="Stretch"
                     Margin="100,0">
            <Button Style="{StaticResource ImageButtonStyle}"
                    Tag="Images/Stand_Up_And_Deliver.png"
                    Click="StandUpAndDeliver_Click"/>
            <Button Style="{StaticResource ImageButtonStyle}"
                    Tag="Images/Think_Quest.png"
                    Click="ThinkQuest_Click"/>
            <Button Style="{StaticResource ImageButtonStyle}"
                    Tag="Images/Travelogue.png"
                    Click="Travelogue_Click"/>
            <Button Style="{StaticResource ImageButtonStyle}"
                    Tag="Images/Worth_The_Whisk.png"
                    Click="WorthTheWhisk_Click"/>
        </UniformGrid>

        </Grid>
</Window>
